{
  "name": "unusualactivity",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @unusual/api\" \"npm run dev -w @unusual/web\"",
    "test": "npm run test -w @unusual/api",
    "build": "npm run build -w @unusual/web"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
